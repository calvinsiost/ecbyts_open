# ecbyts_open — .env.example
#
# Guest Mode needs NO backend and NO real values: the placeholders below are
# exactly what the build uses by default. Do not put real credentials here.
#
# A backend opt-in (bring your own Supabase) is PLANNED but not shipped in
# this version — see docs/future-versions.md. No setup instructions are
# provided on purpose (an instruction you cannot complete is worse than none).

SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_PUBLISHABLE_KEY=placeholder-key
NODE_ENV=development
