{
    "extends": "./tsconfig.app-strict.json",
    "compilerOptions": {
        "noEmit": false,
        "rootDir": "src/app/js",
        "outDir": "app/js",
        "sourceMap": true,
        "declaration": false,
        "incremental": true,
        "tsBuildInfoFile": ".runtime/tsbuildinfo-app-build"
    },
    "include": ["src/app/js/**/*.ts", "types/app/**/*.d.ts"]
}
